{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "podarkino-admin-access",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-12-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
