{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "podarkino-admin-access",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2025-12-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": { "enabled": true }
}
